APP_NAME=Core Speak API
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://127.0.0.1:8000

# false = MySQL (local Docker 3307 o Aiven). true = SQLite en ./data/corespeak.db
USE_SQLITE=false

# Opción A — URL única (local Docker 3307). Codifica la contraseña si tiene símbolos (@ → %40).
DATABASE_URL=mysql+pymysql://corespeak:corespeak@localhost:3307/corespeak

# Opción B — Aiven / Render: pega la Service URI completa del panel (recomendado)
# MYSQL_SERVICE_URI=mysql://avnadmin:...@mysql-xxxx.i.aivencloud.com:10862/defaultdb?ssl-mode=REQUIRED

# Opción C — variables sueltas (contraseña sin codificar manualmente)
# MYSQL_HOST=mysql-xxxx.i.aivencloud.com
# MYSQL_PORT=10862
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=pega_aqui_la_contraseña_de_aiven
# MYSQL_DATABASE=defaultdb

# Aiven local: ca.pem en infra/aiven/ (ver infra/aiven/README.txt)
# MYSQL_SSL_CA=infra/aiven/ca.pem
# Aiven en Render: pega el contenido completo de ca.pem
# MYSQL_SSL_CA_CONTENT=-----BEGIN CERTIFICATE-----...

JWT_SECRET_KEY=change-me-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# IA (Groq)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

